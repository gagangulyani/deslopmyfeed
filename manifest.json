{
  "manifest_version": 3,
  "name": "DeSlopMyFeed",
  "version": "0.1.0",
  "description": "Locally filters formulaic, generic, and AI-style posts from your LinkedIn feed. No servers, no accounts, no telemetry.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background/settings-writer.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/content/bootstrap.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/detector/*.js",
        "src/storage/*.js"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "DeSlopMyFeed",
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  }
}
